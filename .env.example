LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
PORT=3000
TODO_FILE=./data/todos.jsonl
# e學苑：登入後 → 行事曆 → 匯出 → 課程相關事件 → 今天到未來六十天 → 取得網址。
# 含私人授權碼，只能存於本機，請勿貼到 LINE、聊天或 Git。
ELEARN_CALENDAR_URL=
ELEARN_STATE_FILE=./data/elearn.json
# 本機 Ollama 模型；需已安裝。問答不使用雲端 LLM。
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# LINE 可連到的 HTTPS 通道根網址（不含 /webhook）。通道更換時一併更新。
PUBLIC_BASE_URL=
