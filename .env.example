LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
PORT=3000
TODO_FILE=./data/todos.jsonl
# e學苑：登入後 → 行事曆 → 匯出 → 課程相關事件 → 今天到未來六十天 → 取得網址。
# 含私人授權碼，只能存於本機，請勿貼到 LINE、聊天或 Git。
ELEARN_CALENDAR_URL=
ELEARN_STATE_FILE=./data/elearn.json
# 本機 Ollama 模型；需已安裝。問答不使用雲端 LLM。
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# LINE 可連到的 HTTPS 通道根網址（不含 /webhook）。通道更換時一併更新。
PUBLIC_BASE_URL=
# 可選：退出時恢復 W5 Apps Script Webhook。只填本機 .env，不可公開或截圖。
# 設定此值即表示要求程式在 Ctrl+C / SIGTERM 後呼叫 LINE API 恢復 Webhook。
W5_WEBHOOK_URL=
# 老師版 Google 功能：先完成 gws 登入，再在本機明確啟用。ID 和憑證不可上傳。
GOOGLE_ENABLED=0
# 可空白沿用既有 e學苑綁定者；其他人與群組不能寫你的 Google 帳號。
GOOGLE_OWNER_ID=
SHEET_ID=
CALENDAR_ID=primary
PHOTO_FOLDER=LINE待辦照片
GWS_PATH=
GOOGLE_STATE_FILE=./data/google-actions.json
# qwen2.5:3b 不支援看圖，照片使用另一個本機模型。
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# Google OAuth 本機隔離目錄：填入此 repo 下 data/gws 的絕對路徑，不上傳憑證。
GOOGLE_WORKSPACE_CLI_CONFIG_DIR=
