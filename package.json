{
  "name": "todo-line-bot",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 line_bot_local.py",
    "test": "node --test bot.test.mjs elearn.test.mjs local-ai.test.mjs photos.test.mjs",
    "evidence": "node scripts/compare-versions.mjs",
    "start:node": "node server.mjs",
    "test:python": "python3 -m unittest -v test_line_bot_local.py test_teacher_features.py test_service.py test_evaluate_faq.py test_classroom_check.py test_reliability.py test_phone_regressions.py",
    "test:live": "python3 scripts/check-live-quality.py",
    "test:faq": "python3 scripts/evaluate-faq.py"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.11.2",
    "ipaddr.js": "2.5.0",
    "node-ical": "0.22.1",
    "sharp": "0.35.5"
  }
}
